---
interface TechCategory {
  name: string;
  items: string[];
}

const techCategories: TechCategory[] = [
  {
    name: 'Frontend',
    items: ['Next.js', 'React', 'Tailwind CSS'],
  },
  {
    name: 'Backend',
    items: ['Laravel', 'Node.js', 'PHP'],
  },
  {
    name: 'Database',
    items: ['MySQL', 'MariaDB', 'PostgreSQL'],
  },
  {
    name: 'Tools',
    items: ['Git', 'Docker'],
  },
];
---

<div class="flex flex-wrap gap-4 mb-8">
  {techCategories.map((category) => (
    <div class="flex flex-col items-start gap-1.5">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">
        {category.name}
      </span>
      <div class="flex flex-wrap gap-1.5">
        {category.items.map((tech) => (
          <span class="px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-full border border-gray-200/60 hover:border-red-200 hover:bg-red-50 hover:text-red-700 transition-colors">
            {tech}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
