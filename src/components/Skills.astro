---
// src/components/Skills.astro
// Skills section interaktif dengan filter kategori
---
<section id="skills" class="min-h-screen flex items-center justify-center bg-[#0a0a0f] overflow-hidden relative">
  <!-- Background grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="container mx-auto px-4 py-20 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-block text-xs font-semibold tracking-[0.2em] uppercase text-white/40 mb-4">Keahlian Saya</span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Skills &amp; Technologies</h2>
      <p class="text-white/50 max-w-md mx-auto">Kumpulan bahasa, framework, tools, dan bidang yang saya pelajari dan gunakan.</p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-3 mb-10" id="skills-filter">
      <button class="filter-btn active px-4 py-2 text-sm font-medium rounded-full border border-white/10 bg-gradient-to-r from-purple-500/20 to-cyan-500/20 text-white shadow-sm transition-all hover:from-purple-500/30 hover:to-cyan-500/30" data-filter="all">Semua</button>
      <button class="filter-btn px-4 py-2 text-sm font-medium rounded-full border border-white/10 bg-white/5 text-white/60 hover:text-white hover:bg-white/10 transition-all" data-filter="programming">Pemrograman</button>
      <button class="filter-btn px-4 py-2 text-sm font-medium rounded-full border border-white/10 bg-white/5 text-white/60 hover:text-white hover:bg-white/10 transition-all" data-filter="frontend">Frontend</button>
      <button class="filter-btn px-4 py-2 text-sm font-medium rounded-full border border-white/10 bg-white/5 text-white/60 hover:text-white hover:bg-white/10 transition-all" data-filter="backend">Backend</button>
      <button class="filter-btn px-4 py-2 text-sm font-medium rounded-full border border-white/10 bg-white/5 text-white/60 hover:text-white hover:bg-white/10 transition-all" data-filter="database">Database</button>
      <button class="filter-btn px-4 py-2 text-sm font-medium rounded-full border border-white/10 bg-white/5 text-white/60 hover:text-white hover:bg-white/10 transition-all" data-filter="tools">Tools</button>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="skills-grid">
      <!-- Pemrograman -->
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/5 transition-all duration-300" data-category="programming">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-purple-400/70 group-hover:text-purple-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">PHP</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Pemrograman</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/5 transition-all duration-300" data-category="programming">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-purple-400/70 group-hover:text-purple-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Java</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Pemrograman</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/5 transition-all duration-300" data-category="programming">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-purple-400/70 group-hover:text-purple-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">JavaScript</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Pemrograman</span>
      </div>

      <!-- Frontend -->
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-500/5 transition-all duration-300" data-category="frontend">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-cyan-400/70 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Next.js</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Frontend</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-500/5 transition-all duration-300" data-category="frontend">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-cyan-400/70 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">React</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Frontend</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-500/5 transition-all duration-300" data-category="frontend">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-cyan-400/70 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Tailwind CSS</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Frontend</span>
      </div>

      <!-- Backend -->
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-pink-500/30 hover:shadow-lg hover:shadow-pink-500/5 transition-all duration-300" data-category="backend">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-pink-400/70 group-hover:text-pink-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Laravel</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Backend</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-pink-500/30 hover:shadow-lg hover:shadow-pink-500/5 transition-all duration-300" data-category="backend">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-pink-400/70 group-hover:text-pink-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Node.js</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Backend</span>
      </div>

      <!-- Database -->
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-green-500/30 hover:shadow-lg hover:shadow-green-500/5 transition-all duration-300" data-category="database">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-green-400/70 group-hover:text-green-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0L4 7m8 8l-8-4-8 4m16 0L4 7"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">MySQL</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Database</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-green-500/30 hover:shadow-lg hover:shadow-green-500/5 transition-all duration-300" data-category="database">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-green-400/70 group-hover:text-green-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0L4 7m8 8l-8-4-8 4m16 0L4 7"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">MariaDB</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Database</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-green-500/30 hover:shadow-lg hover:shadow-green-500/5 transition-all duration-300" data-category="database">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-green-400/70 group-hover:text-green-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0L4 7m8 8l-8-4-8 4m16 0L4 7"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">PostgreSQL</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Database</span>
      </div>

      <!-- Tools -->
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5 transition-all duration-300" data-category="tools">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-amber-400/70 group-hover:text-amber-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Git</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Tools</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5 transition-all duration-300" data-category="tools">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-amber-400/70 group-hover:text-amber-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Docker</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Tools</span>
      </div>
      <div class="skill-card relative group p-4 rounded-xl bg-[#0f0f14] border border-white/[0.06] hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5 transition-all duration-300" data-category="tools">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500/20 to-cyan-500/20 flex items-center justify-center mb-3">
          <svg class="w-4 h-4 text-amber-400/70 group-hover:text-amber-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        </div>
        <span class="skill-name text-sm font-semibold text-white block text-center">Vite</span>
        <span class="skill-badge text-[10px] font-medium text-white/30 uppercase tracking-wider block text-center mt-1">Tools</span>
      </div>
    </div>
  </div>

  <script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const skillCards = document.querySelectorAll('.skill-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'from-purple-500/20', 'to-cyan-500/20');
          b.classList.add('bg-white/5', 'text-white/60');
        });
        btn.classList.add('active', 'from-purple-500/20', 'to-cyan-500/20');
        btn.classList.remove('bg-white/5', 'text-white/60');

        const filter = btn.dataset.filter;

        skillCards.forEach(card => {
          if (filter === 'all' || card.dataset.category === filter) {
            card.style.display = '';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</section>
