---
// src/components/LoadingScreen.astro - Morphing liquid blob loading screen (dark)
---
<div id="loading-screen" class="loading-screen">
  <div class="blob">
    <div class="blob-core"></div>
  </div>
  <p class="loading-text">Loading experience...</p>
  <script>
    setTimeout(() => {
      const el = document.getElementById('loading-screen');
      if (el) el.classList.add('loading-screen--hidden');
    }, 2000);
  </script>
</div>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0a0a0f;
    transition: opacity 0.4s ease;
  }
  .loading-screen--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .blob {
    width: 120px;
    height: 120px;
    border-radius: 40% 60% 65% 35% / 45% 55% 45% 55%;
    background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
    animation: blob-morph 3.5s ease-in-out infinite, blob-float 4s ease-in-out infinite;
    box-shadow: 0 0 50px rgba(124,58,237,0.25);
    position: relative;
  }
  .blob::after {
    content: '';
    position: absolute;
    inset: -12px;
    border-radius: inherit;
    background: inherit;
    filter: blur(18px);
    opacity: 0.45;
    z-index: -1;
  }
  .blob-core {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, #a78bfa 0%, #22d3ee 100%);
    animation: blob-morph 3.5s ease-in-out infinite reverse;
  }

  @keyframes blob-morph {
    0%   { border-radius: 40% 60% 65% 35% / 45% 55% 45% 55%; }
    25%  { border-radius: 65% 35% 55% 45% / 55% 45% 55% 45%; }
    50%  { border-radius: 35% 65% 50% 50% / 45% 55% 65% 35%; }
    75%  { border-radius: 55% 45% 40% 60% / 50% 45% 55% 50%; }
    100% { border-radius: 40% 60% 65% 35% / 45% 55% 45% 55%; }
  }
  @keyframes blob-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50%      { transform: translateY(-12px) scale(1.04); }
  }

  .loading-text {
    margin-top: 28px;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.01em;
    animation: pulse-text 2.5s ease-in-out infinite;
    font-family: 'Inter', sans-serif;
  }
  @keyframes pulse-text {
    0%, 100% { opacity: 0.4; }
    50%      { opacity: 0.8; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob, .blob-core { animation: none; }
    .loading-text     { animation: none; }
  }
</style>
