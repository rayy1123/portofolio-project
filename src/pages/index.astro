---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import Skills from '../components/Skills.astro';
import MasteryStack from '../components/MasteryStack.astro';
import LoadingScreen from '../components/LoadingScreen.astro';

const projects = [  
  {
    id: 1,
    title: 'Rajendra Meet',
    tech: ['Next.js', 'Tailwind CSS', 'PostgreSQL', 'Prisma'],
    description: 'Website Kejuaraan Renang dengan Sistem Standar Nasional.',
    repoSlug: 'rajendra-meet',
    banner: '/assets/rajendra meet.png',
    featured: true,
    liveUrl: 'https://github.com/rayy1123/rajendra-meet',
  },
  {
    id: 2,
    title: 'Bawaslos',
    tech: ['React', 'Node.js', 'Express', 'MongoDB'],
    description: 'Platform manajemen pemilihan umum dengan dashboard interaktif dan sistem voting.',
    repoSlug: 'bawaslos',
    banner: '/assets/Bawaslos.png',
    featured: true,
    liveUrl: 'https://github.com/rayy1123/bawaslos',
  },
  {
    id: 3,
    title: 'UKK Peminjaman Alat',
    tech: ['PHP', 'Laravel', 'MySQL', 'Bootstrap'],
    description: 'Sistem peminjaman alat berbasis web untuk Unit Keterampilan Kejuruan (UKK).',
    repoSlug: 'ukk-peminjaman-alat',
    banner: '/assets/peminjaman.png',
    featured: true,
    liveUrl: 'https://github.com/rayy1123/ukk-peminjaman-alat',
  },
  {
    id: 4,
    title: 'SkillByte',
    tech: ['Laravel', 'Vue.js', 'MySQL', 'Tailwind CSS'],
    description: 'SkillByte adalah aplikasi Micro Learning Management System (LMS) berbasis decoupled full-stack architecture yang kamu bangun sebagai proyek portofolio rekayasa perangkat lunak. Aplikasi ini memisahkan struktur backend dan frontend menggunakan RESTful API.',
    repoSlug: 'skillbyte',
    banner: '/assets/skillbyte.png',
    featured: true,
    liveUrl: 'https://github.com/rayy1123/skillbyte',
  },
];
---

<Layout title="Rayvanes Arrasyid | Web Developer">
  <LoadingScreen />

  <!-- ===== HERO SECTION ===== -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-hero">
    <!-- Glow orbs -->
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-purple-500/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 -right-32 w-80 h-80 bg-cyan-500/8 rounded-full blur-[80px] pointer-events-none"></div>

    <div class="container mx-auto px-4 relative z-10 text-center">
      <!-- Label -->
      <span class="inline-block text-xs font-semibold tracking-[0.2em] uppercase text-white/40 mb-6 anim-fade-in">
        Web Developer | SMKN 64 Jakarta
      </span>

      <!-- Heading -->
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-6 anim-slide-up">
        Rayvanes <br class="sm:hidden" />
        <span class="gradient-text">Arrasyid</span>
      </h1>

      <!-- Sub heading -->
      <p class="text-lg sm:text-xl text-white/60 max-w-xl mx-auto mb-10 leading-relaxed anim-slide-up delay-200">
        Membangun aplikasi web yang elegan, performa-optimal, dan berpusat pada pengguna.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap justify-center gap-4 anim-fade-in delay-300">
        <a
          href="https://drive.google.com/drive/folders/171lXAUmAl5ldr20jIz-sNB2DI-3U72sp?usp=drive_link"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-purple-600 to-cyan-600 text-white font-semibold shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transition-all hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CV
        </a>
        <a
          href="https://github.com/rayy1123"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/10 text-white/80 font-semibold hover:bg-white/5 hover:border-white/20 transition-all hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          GitHub
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
      <span class="text-[10px] tracking-widest uppercase">Scroll</span>
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- ===== ABOUT SECTION ===== -->
  <section id="about" class="relative py-20 md:py-32 bg-gradient-about overflow-hidden">
    <!-- Subtle top glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-32 bg-purple-500/5 rounded-full blur-[60px]"></div>

    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-16">
        <span class="inline-block text-xs font-semibold tracking-[0.2em] uppercase text-white/40 mb-4 anim-slide-left">Tentang Saya</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 anim-slide-left delay-100">Background &amp; Visi</h2>
        <p class="text-white/50 max-w-2xl mx-auto leading-relaxed anim-slide-left delay-200">
          Saya adalah Web Developer yang berkomitmen menghasilkan solusi digital berkualitas.
          Pendidikan di SMKN 64 Jakarta jurusan Rekayasa Perangkat Lunak menjadi fondasi kuat
          dalam perjalanan saya mengasah kemampuan teknologi web dan desktop.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Pendidikan card -->
        <div class="glass p-6 text-center anim-slide-up delay-100">
          <div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-white font-semibold text-lg mb-1">Pendidikan</h3>
          <p class="text-white/40 text-sm">SMKN 64 Jakarta</p>
          <p class="text-white/30 text-xs mt-1">RPL — Rekayasa Perangkat Lunak</p>
        </div>

        <!-- Fokus card -->
        <div class="glass p-6 text-center anim-slide-up delay-200">
          <div class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-white font-semibold text-lg mb-1">Fokus</h3>
          <p class="text-white/40 text-sm">Web Developer</p>
          <p class="text-white/30 text-xs mt-1">Full-Stack &amp; Desktop App</p>
        </div>

        <!-- Lokasi card -->
        <div class="glass p-6 text-center anim-slide-up delay-300">
          <div class="w-12 h-12 bg-pink-500/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-white font-semibold text-lg mb-1">Lokasi</h3>
          <p class="text-white/40 text-sm">Jakarta, Indonesia</p>
          <p class="text-white/30 text-xs mt-1">Tersedia remote</p>
        </div>
      </div>

      <!-- Mastery Stack logos -->
      <div class="mt-16 text-center anim-fade-in delay-300">
        <div class="inline-block glass-strong px-6 py-8 inline-flex flex-col items-center gap-4">
          <span class="text-xs text-white/40 tracking-widest uppercase">Tech Mastery</span>
          <MasteryStack />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SKILLS SECTION ===== -->
  <Skills />

  <!-- ===== PROJECTS SECTION ===== -->
  <section id="projects" class="relative py-20 md:py-32 bg-gradient-projects overflow-hidden">
    <div class="absolute top-1/2 left-0 w-64 h-64 bg-purple-500/5 rounded-full blur-[80px] pointer-events-none"></div>

    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-16">
        <span class="inline-block text-xs font-semibold tracking-[0.2em] uppercase text-white/40 mb-4 anim-slide-left">Portfolio Proyek</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 anim-slide-left delay-100">Proyek yang Saya Kembangkan</h2>
        <p class="text-white/50 max-w-2xl mx-auto leading-relaxed anim-slide-left delay-200">
          Kumpulan proyek yang merepresentasikan kemampuan dan passion saya dalam membangun aplikasi web dan desktop.
        </p>
      </div>

      <ProjectShowcase projects={projects} />
    </div>
  </section>

  <!-- ===== CONTACT SECTION ===== -->
  <section id="contact" class="relative py-20 md:py-32 bg-gradient-contact overflow-hidden">
    <div class="absolute bottom-0 right-0 w-72 h-72 bg-cyan-500/5 rounded-full blur-[80px] pointer-events-none"></div>

    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-16">
        <span class="inline-block text-xs font-semibold tracking-[0.2em] uppercase text-white/40 mb-4 anim-slide-left">Kontak</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 anim-slide-left delay-100">Mari Terhubung</h2>
        <p class="text-white/50 max-w-xl mx-auto leading-relaxed anim-slide-left delay-200">
          Punya proyek atau kesempatan kolaborasi? Jangan ragu untuk menghubungi saya melalui tautan di bawah.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-4 anim-fade-in delay-300">
        <a
          href="mailto:rayvanesarrasyid@gmail.com"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-full glass-strong text-white/80 hover:text-white transition-all hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10 active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email Saya
        </a>
        <a
          href="https://github.com/rayy1123"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-6 py-3 rounded-full glass-strong text-white/80 hover:text-white transition-all hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/10 active:scale-95"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>
</Layout>